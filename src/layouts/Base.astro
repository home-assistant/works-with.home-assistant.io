---
import "../styles/_index.scss";

import metadata from "../data/metadata.js";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Symbol sprite consumed by the `<use xlink:href="#...">` icons in
// WhatsInvolved.astro. It has to be inline in the document to be referenced.
import slideSprites from "../svg/slide-sprites.svg?raw";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang={metadata.language}>
	<head>
		<Head title={title} description={description} noindex={noindex} />
	</head>
	<body>
		<Fragment set:html={slideSprites} />
		<Header />
		<slot />
		<Footer />
		<script>
			import "../scripts/index.js";
		</script>
	</body>
</html>
