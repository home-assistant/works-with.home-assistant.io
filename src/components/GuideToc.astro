---
interface TocChild {
  id: string;
  label: string;
}

interface TocEntry {
  id: string;
  label: string;
  children?: TocChild[];
}

interface Props {
  toc: TocEntry[];
}

const { toc } = Astro.props;
---

<fieldset class="guide-toc">
  <p class="guide-toc-heading">Contents</p>

  <ul class="guide-tablist">
    {
      toc.map((entry) =>
        entry.children?.length ? (
          <li class="guide-tablist-item">
            <input
              type="checkbox"
              id={`subnav-${entry.id}`}
              class="guide-subnav-toggle-input"
              checked
            />
            <div class="guide-tablist-row">
              <a class="guide-pill nounderline" href={`#${entry.id}`}>
                {entry.label}
              </a>
              <label for={`subnav-${entry.id}`} class="guide-subnav-toggle">
                <span class="guide-toc-arrow" aria-hidden="true" />
                <span class="visually-hidden">
                  Toggle {entry.label} sections
                </span>
              </label>
            </div>
            <ul class="guide-sublist">
              {entry.children.map((child) => (
                <li>
                  <a
                    class="guide-pill guide-pill--sub nounderline"
                    href={`#${child.id}`}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ) : (
          <li>
            <a class="guide-pill nounderline" href={`#${entry.id}`}>
              {entry.label}
            </a>
          </li>
        ),
      )
    }
  </ul>

  <div class="guide-toc-mobile">
    <input type="checkbox" id="toc-toggle" class="guide-toc-toggle-input" />
    <label for="toc-toggle" class="guide-toc-toggle">
      <span class="guide-toc-toggle-pill">
        On this page
        <span class="guide-toc-arrow" aria-hidden="true"></span>
      </span>
      <span class="guide-toc-current">{toc[0]?.label}</span>
    </label>
    <ul class="guide-jumplist">
      {
        toc.map((entry) => (
          <li>
            <a class="nounderline" href={`#${entry.id}`}>
              {entry.label}
            </a>
            {entry.children?.length ? (
              <ul class="guide-sublist">
                {entry.children.map((child) => (
                  <li>
                    <a class="nounderline" href={`#${child.id}`}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))
      }
    </ul>
  </div>
</fieldset>

<script>
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      ".guide-pill, .guide-jumplist a",
    ),
  );
  const current = document.querySelector<HTMLElement>(".guide-toc-current");
  const tocToggleInput = document.getElementById(
    "toc-toggle",
  ) as HTMLInputElement | null;

  const linksByHref = new Map<string, HTMLAnchorElement[]>();
  tocLinks.forEach((link) => {
    const href = link.getAttribute("href");
    if (!href) return;
    const group = linksByHref.get(href) ?? [];
    group.push(link);
    linksByHref.set(href, group);
  });

  const setCurrent = (id: string) => {
    const href = `#${id}`;
    const heading = document.getElementById(id);
    if (current && heading?.textContent)
      current.textContent = heading.textContent;

    linksByHref.forEach((links, href2) => {
      links.forEach((link) => {
        if (href2 === href) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    });
  };

  const targets = Array.from(linksByHref.keys())
    .map((href) => document.getElementById(href.slice(1)))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length && current) {
    setCurrent(targets[0].id);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length) setCurrent(visible[0].target.id);
      },
      { rootMargin: "-120px 0px -70% 0px" },
    );

    targets.forEach((target) => observer.observe(target));
  }

  document
    .querySelectorAll<HTMLAnchorElement>(".guide-jumplist a")
    .forEach((link) => {
      link.addEventListener("click", () => {
        if (tocToggleInput) tocToggleInput.checked = false;
      });
    });
</script>

<style lang="scss">
  @use "../styles/mixins";

  .guide-toc {
    background: var(--body-background-color);
    border: 0;
    margin: 0 0 24px;
    min-width: 0;
    padding: 8px 0;
    position: sticky;
    z-index: 3;
    top: 73px;

    align-items: center;
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    box-sizing: border-box;
    width: 100vw;
    margin-left: calc(var(--layout-container-padding) * -1);
    padding-left: var(--layout-container-padding);
    padding-right: var(--layout-container-padding);
    box-shadow:
      0px 8px 4px rgba(0, 0, 0, 0.03),
      0px 5px 2px rgba(0, 0, 0, 0.03),
      0px 3px 2px rgba(0, 0, 0, 0.06),
      0px 1px 1px rgba(0, 0, 0, 0.06);

    @include mixins.bp(tablet) {
      top: 91px;
    }

    @include mixins.bp(desktop) {
      align-items: stretch;
      background: none;
      box-shadow: none;
      flex-direction: column;
      margin: 0;
      padding: 0;
      top: 125px;
      width: auto;
    }
  }

  .guide-toc-heading {
    color: var(--color-primary);
    display: none;
    font-weight: 400;
    margin: 0;
    padding: 0;

    @include mixins.bp(desktop) {
      display: block;
      font-size: 1.25rem;
      margin: 0 0 0.625rem;
    }
  }

  .guide-tablist {
    display: none;
    flex-direction: column;
    gap: 0.625rem;
    list-style: none;
    margin: 0;
    padding: 0;

    @include mixins.bp(desktop) {
      display: flex;
    }

    li {
      margin: 0;
      padding: 0;
    }
  }

  .guide-tablist-item {
    display: flex;
    flex-direction: column;
  }

  .guide-tablist-row {
    align-items: center;
    display: flex;
    gap: 0.375rem;

    .guide-pill {
      flex: 1 1 auto;
    }
  }

  .guide-pill {
    border-radius: 0.5rem;
    color: var(--color-secondary);
    cursor: pointer;
    display: block;
    font-size: 0.875rem;
    font-weight: 300;
    padding: 0.625rem 1rem;
    text-decoration: none;
    transition:
      background-color 0.2s ease-out,
      color 0.2s ease-out;
    border: 1px solid var(--color-tertiary);

    &:hover {
      background-color: var(--color-tertiary);
    }

    &[aria-current="true"] {
      background: var(--color-tertiary);
    }

    &:focus-visible {
      outline: 2px solid var(--brand-color-home-assistant-blue);
      outline-offset: 2px;
    }

    &--sub {
      font-size: 0.8125rem;
    }
  }

  .guide-subnav-toggle-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;

    &:checked ~ .guide-sublist {
      display: flex;
    }

    &:checked ~ .guide-tablist-row .guide-toc-arrow {
      transform: rotate(45deg);
    }

    &:focus-visible ~ .guide-tablist-row .guide-subnav-toggle {
      outline: 2px solid var(--brand-color-home-assistant-blue);
      outline-offset: 2px;
    }
  }

  .guide-subnav-toggle {
    align-items: center;
    border-radius: 0.375rem;
    cursor: pointer;
    display: flex;
    flex-shrink: 0;
    height: 2rem;
    justify-content: center;
    width: 2rem;

    &:hover {
      background-color: var(--color-tertiary);
    }
  }

  .guide-sublist {
    display: none;
    flex-direction: column;
    gap: 0.375rem;
    list-style: none;
    margin: 0.375rem 0 0;
    padding: 0 0 0 1rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .guide-toc-mobile {
    position: relative;
    width: 100%;

    @include mixins.bp(desktop) {
      display: none;
    }
  }

  .guide-toc-toggle-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;

    &:checked ~ .guide-jumplist {
      display: block;
    }

    &:checked ~ .guide-toc-toggle .guide-toc-arrow {
      transform: rotate(45deg);
    }

    &:focus-visible ~ .guide-toc-toggle .guide-toc-toggle-pill {
      outline: 2px solid var(--brand-color-home-assistant-blue);
      outline-offset: 2px;
    }
  }

  .guide-toc-toggle {
    align-items: center;
    cursor: pointer;
    display: flex;
    gap: 0.75rem;
    min-width: 0;
    width: 100%;
  }

  .guide-toc-toggle-pill {
    align-items: center;
    background: var(--color-tertiary);
    border-radius: 999px;
    display: flex;
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
  }

  .guide-toc-arrow {
    border-bottom: 2px solid currentColor;
    border-right: 2px solid currentColor;
    flex-shrink: 0;
    height: 6px;
    transform: rotate(-45deg);
    transition: transform 0.2s ease-out;
    width: 6px;
  }

  .guide-toc-current {
    color: var(--color-primary);
    font-size: 0.9375rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .guide-jumplist {
    background: var(--body-background-color);
    border: 1px solid rgba(0, 35, 50, 0.12);
    border-top: none;
    border-radius: 0 0 12px 12px;
    box-shadow: 0 1rem 24px rgba(0, 35, 50, 0.12);
    display: none;
    left: 0;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0 1rem;
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 4;

    li {
      border-top: 1px solid rgba(0, 35, 50, 0.08);
      margin: 0;
      padding: 0;

      &:first-child {
        border-top: none;
      }
    }

    a {
      display: block;
      font-size: 15px;
      font-weight: 500;
      padding: 12px 0;
      text-decoration: none;
      color: var(--color-secondary);

      &[aria-current="true"] {
        color: var(--color-primary);
        font-weight: 700;
      }
    }

    .guide-sublist {
      display: flex;
      margin: 0;
      padding: 0 0 12px 1rem;

      li {
        border-top: none;
      }

      a {
        font-size: 14px;
        padding: 8px 0;
      }
    }
  }
</style>
