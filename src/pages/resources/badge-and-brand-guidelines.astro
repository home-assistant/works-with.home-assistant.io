---
import Base from "../../layouts/Base.astro";
import GuideToc from "../../components/GuideToc.astro";
import GuidelineCard from "../../components/GuidelineCard.astro";
import InfoCard from "../../components/InfoCard.astro";
import NoteCard from "../../components/NoteCard.astro";
import AssetCard from "../../components/AssetCard.astro";

const sections = [
  { id: "introduction", label: "Introduction" },
  { id: "download-centre", label: "Download Center" },
  { id: "wwha-badge", label: "The Works with Home Assistant badge" },
  { id: "using-the-brand", label: "How to use the Home Assistant brand" },
  { id: "co-branding-packaging", label: "Co-branding and packaging" },
  {
    id: "communicating-functionality",
    label: "Communicating device functionality and limitations",
  },
  { id: "need-help", label: "Need help?" },
];
---

<Base
  title="Badge and Brand Guidelines"
  description="Guidelines for using the Works with Home Assistant badge and brand assets."
  noindex
>
  <div class="wrapper wrapper-overflow-visible">
    <section class="guide-hero brand-hero">
      <div class="container">
        <h1 id="badge-and-brand-guidelines">
          Works with Home Assistant Badge and Brand Guidelines
        </h1>
        <p class="subtitle">For Works with Home Assistant certified partners</p>
      </div>
    </section>

    <article class="guide brand">
      <div class="guide-layout container">
        <GuideToc toc={sections} />

        <div class="guide-panels">
          <section id="introduction" class="guide-panel">
            <h2>Introduction</h2>
            <p>
              Welcome! These guidelines are designed to help our Works with Home
              Assistant partners create consistent branding, packaging, and
              written content that connects with our shared customers, so that
              devices certified to the Works with Home Assistant program are
              easily recognizable. By aligning our look and language, we'll
              ensure our mission has maximum impact.
            </p>

            <GuidelineCard
              title="Home Assistant"
              logoSrc="https://brands.openhomefoundation.org/api/home-assistant/logo/screen/lockup/main/color/light/svg"
              logoAlt="Home Assistant Logo"
            >
              <p>
                Home Assistant is an open source home automation platform that
                puts local control and privacy first, giving you full control
                over your data with no cloud required. As one of the Open Home
                Foundation's core projects, Home Assistant is powered by a
                global community of users and developers, all working together
                to ensure the platform is constantly evolving and improving.
                Home Assistant offers a simple, powerful, and sustainable way to
                automate your home.
              </p>
            </GuidelineCard>

            <GuidelineCard
              title="Your Works with Home Assistant certification"
              logoSrc="/img/logos/wwha-colored-light-grey-background.webp"
              logoAlt="Works With Home Assistant Badge"
            >
              <p>
                The Works with Home Assistant certification is designed to
                ensure the Home Assistant community can identify which devices
                provide the best smart home experience within their setup. The
                program highlights devices that prioritize local, private, and
                secure operation while advancing sustainability within the smart
                home.
              </p>
              <p>
                If your device or product has an active, formal certificate
                under the Works with Home Assistant program, you can access the
                “Works with” badge via the <a href="#download-centre"
                  >Download Center</a
                > and use it for that device’s product packaging or website listing.
              </p>
            </GuidelineCard>
          </section>

          <hr class="part-divider" />

          <section id="download-centre" class="guide-panel">
            <h2>Download Center</h2>
            <p>Need files? All badges and logos are available for download.</p>

            <div class="card-row card-row--2">
              <GuidelineCard title="Works with Home Assistant Badge">
                <p class="title title--download">Digital</p>
                <a
                  href="/downloads/works-with-home-assistant-logos--digital.zip"
                  class="button--download nounderline"
                  download>Download</a
                >
                <p class="title title--download">Print</p>
                <a
                  href="/downloads/works-with-home-assistant-logos--print.zip"
                  class="button--download nounderline"
                  download>Download</a
                >
              </GuidelineCard>

              <GuidelineCard title="Home Assistant Logo">
                <p class="title title--download">Digital</p>
                <a
                  href="/downloads/home-assistant-logos--digital.zip"
                  class="button--download nounderline"
                  download>Download</a
                >
                <p class="title title--download">Print</p>
                <a
                  href="/downloads/home-assistant-logos--print.zip"
                  class="button--download nounderline"
                  download>Download</a
                >
              </GuidelineCard>
            </div>
          </section>

          <hr class="part-divider" />

          <section id="wwha-badge" class="guide-panel">
            <h2>The Works with Home Assistant badge</h2>
            <h3 class="title">Color variations</h3>

            <GuidelineCard>
              <div class="card-content-row">
                <div class="card-content">
                  <p class="title">Colored version on light grey background</p>
                  <p>
                    When in doubt, use this, as it is the default and official
                    version. Prioritize this version in all brand collateral.
                  </p>
                </div>
                <div class="card-media">
                  <img
                    src="/img/logos/wwha-colored-light-grey-background.webp"
                    alt="Works With Home Assistant Badge"
                  />
                </div>
              </div>
            </GuidelineCard>

            <GuidelineCard>
              <div class="card-content-row">
                <div class="card-content">
                  <p class="title">Colored version on white background</p>
                  <p>
                    Colored version on white background – only to be used on
                    dark backgrounds, for example on a page with a dark theme.
                  </p>
                </div>
                <div class="card-media">
                  <img
                    src="/img/logos/wwha-colored-white-background.webp"
                    alt="Works With Home Assistant Badge - Colored version on white background"
                  />
                </div>
              </div>
            </GuidelineCard>

            <GuidelineCard>
              <div class="card-content-row">
                <div class="card-content">
                  <p class="title">Monochrome on light and dark background</p>
                  <p>
                    Use the fully black or fully white version on photographic
                    backgrounds to ensure good readability, or in printed
                    materials where color is unavailable.
                  </p>
                </div>
                <div class="card-media">
                  <img
                    src="/img/logos/wwha-monochrome.webp"
                    alt="Works With Home Assistant Badge - Monochrome on light and dark background"
                  />
                </div>
              </div>
            </GuidelineCard>

            <div class="card-row card-row--2">
              <InfoCard variant="error" title="Incorrect use">
                <ul>
                  <li>
                    Do not use the badge on the actual device or any Printed
                    Circuit Boards (PCBs).
                  </li>
                  <li>
                    Do not use the badge in any material for a device which does
                    not have the Works with Home Assistant certification.
                  </li>
                  <li>
                    Do not use the badge if your device no longer has an active,
                    formal certificate for the Works with Home Assistant
                    program.
                  </li>
                </ul>
              </InfoCard>

              <InfoCard variant="error" title="What to avoid">
                <ul>
                  <li>Do not add drop shadow.</li>
                  <li>
                    Do not distort or rotate the badge in any way. Do not change
                    the dimensions or move any badge element.
                  </li>
                  <li>Do not change letter spacing.</li>
                  <li>
                    Do not place the logo against any background that doesn't
                    create contrast.
                  </li>
                  <li>
                    Do not change the original solid color with an outline, or
                    add any kind of gradient. Use only the selected color
                    palette.
                  </li>
                </ul>
              </InfoCard>
            </div>

            <NoteCard>
              <p>
                Some older versions of the badge are now deprecated and should
                not be used. <strong
                  >Please only use the current, approved files in the <a
                    href="#download-centre">Download Center</a
                  >.</strong
                >
              </p>
            </NoteCard>
          </section>

          <hr class="part-divider" />

          <section id="using-the-brand" class="guide-panel">
            <h2>How to use the Home Assistant brand</h2>

            <h3 class="title">Color variations</h3>

            <GuidelineCard>
              <div class="card-content-row">
                <div class="card-content">
                  <p class="title">Colored version on light background</p>
                  <p>
                    When in doubt, use this, as it is the default and official
                    version. Prioritize this version in all brand collateral.
                  </p>
                </div>
                <div class="card-media">
                  <img
                    src="https://brands.openhomefoundation.org/api/home-assistant/logo/screen/lockup/main/color/light/svg"
                    alt="Home Assistant colored version on light background logo"
                  />
                </div>
              </div>
            </GuidelineCard>
            <GuidelineCard>
              <div class="card-content-row">
                <div class="card-content">
                  <p class="title">Colored version on dark background</p>
                  <p>
                    Only to be used on dark backgrounds, for example on a page
                    with a dark theme.
                  </p>
                </div>
                <div class="card-media card-media--dark">
                  <img
                    src="https://brands.openhomefoundation.org/api/home-assistant/logo/screen/lockup/main/monochrome/dark/svg"
                    alt="Home Assistant colored version on dark background logo"
                  />
                </div>
              </div>
            </GuidelineCard>
            <GuidelineCard>
              <div class="card-content-row">
                <div class="card-content">
                  <p class="title">Monochrome on light and dark background</p>
                  <p>
                    Use the fully black or fully white version on photographic
                    backgrounds to ensure good readability, or in printed
                    materials where color is unavailable.
                  </p>
                </div>
                <div class="card-media">
                  <img
                    src="https://brands.openhomefoundation.org/api/home-assistant/logo/screen/lockup/main/monochrome/light/svg"
                    alt="Home Assistant monochrome on light and dark background logo"
                  />
                </div>
              </div>
            </GuidelineCard>

            <div class="card-row card-row--2">
              <InfoCard variant="error" title="Incorrect use">
                <ul>
                  <li>
                    Do not use the logo in the place of the Works with badge.
                    The badge should always be the default way to show
                    compatibility unless the format is completely incompatible.
                  </li>
                  <li>Do not use the logo on device packaging.</li>
                  <li>
                    Do not use the logo if your device no longer has an active,
                    formal certificate for the Works with Home Assistant
                    program.
                  </li>
                </ul>
              </InfoCard>

              <InfoCard variant="error" title="What to avoid">
                <ul>
                  <li>Do not add drop shadow.</li>
                  <li>
                    Do not distort or rotate the logo in any way. Do not change
                    the dimensions or move any logo element.
                  </li>
                  <li>Do not change letter spacing.</li>
                  <li>
                    Do not place the logo against any background that doesn't
                    create contrast.
                  </li>
                  <li>
                    Do not change the original solid color with an outline, or
                    add any kind of gradient. Use only the selected color
                    palette.
                  </li>
                </ul>
              </InfoCard>
            </div>

            <NoteCard>
              <p>
                Some older versions of the Home Assistant logo are now
                deprecated and should not be used. <strong
                  >Please only use the current, approved files in the <a
                    href="#download-centre">Download Center</a
                  >.</strong
                >
              </p>
            </NoteCard>

            <h3>Using the Home Assistant name</h3>
            <p>
              If devices have been formally certified, you are welcome to
              reference this in written copy on marketing materials. Please
              ensure the wording states that the device is “certified” under the
              Works with Home Assistant program, or simply “Works with Home
              Assistant”.
            </p>
            <p>
              Always include information on how the device connects, for example
              if it works locally via Matter, Zigbee, Z-Wave, Bluetooth, WiFi,
              or via ESPHome, so users understand if they need additional
              hardware.
            </p>

            <div class="card-row">
              <InfoCard title="Approved examples:">
                <ul>
                  <li>“Certified by the Works with Home Assistant program”</li>
                  <li>“Works with Home Assistant (via Matter etc.)”</li>
                </ul>
              </InfoCard>

              <InfoCard variant="error" title="Prohibited phrasing:">
                <ul>
                  <li>“This product is approved by Home Assistant”</li>
                  <li>“Recommended by Home Assistant”</li>
                  <li>“Home Assistant product”</li>
                </ul>
              </InfoCard>
            </div>
          </section>

          <hr class="part-divider" />

          <section id="co-branding-packaging" class="guide-panel">
            <h2>Co-branding and packaging</h2>
            <p>
              For certified products only, you're welcome to use the Works with
              Home Assistant badge on your product packaging, exhibition
              marketing, brochures, website listings, and Amazon pages. You are
              also welcome to provide it to distributors of your certified
              product.
            </p>
            <p>
              It is common for the Works with Home Assistant badge to be used
              alongside the badges of other smart home “works with” programs.
              When pairing the Works with Home Assistant badge with other badges
              and logos, the badge should be proportionally sized, balanced in
              both width and height, and centered visually.
            </p>
            <p>
              Ensure the badge has ample clearspace around it — at least equal
              to the height of the logotype or logomark — to give it room to
              breathe.
            </p>
            <p>
              Do not change the Works with Home Assistant color palette to match
              other smart home “works with” badges or logos. Only use the <strong
                >color variations</strong
              > provided in these guidelines.
            </p>

            <h3>Examples</h3>

            <p>
              These images show what co-branding should look like in real
              contexts, such as on marketing assets or packaging.
            </p>

            <div class="card-row card-row--2">
              <AssetCard
                src="/img/guidelines/wwha-example-online-digital-use.webp"
                alt="Example online/digital use"
                caption="Online/digital use"
              />
              <AssetCard
                src="/img/guidelines/wwha-example-use-on-packaging.webp"
                alt="Example use on packaging"
                caption="Use on packaging"
              />
            </div>
          </section>

          <hr class="part-divider" />

          <section id="communicating-functionality" class="guide-panel">
            <h2>Communicating device functionality and limitations</h2>
            <p>
              In line with one of the Open Home Foundation's three core
              principles of providing users with choice, being transparent with
              Home Assistant users about device limitations is a priority.
            </p>

            <GuidelineCard
              title="Planning your Works with Home Assistant launch"
            >
              <p>
                <strong
                  >All copy announcing your device(s) Works with Home Assistant
                  certification must be reviewed by the Works with Home
                  Assistant team before it can be shared publicly.</strong
                > This includes copy intended for websites, social media, newsletters,
                blogs, or packaging.
              </p>
              <p>
                The Works with Home Assistant team will also share copy relating
                to your device(s) with you during launch planning to ensure
                consistency.
              </p>
            </GuidelineCard>

            <GuidelineCard title="Informing customers before purchase">
              <p>
                Partners are expected to clearly <strong
                  >communicate functionality limitations to potential buyers</strong
                > - anywhere the device is listed along with the Works with Home Assistant
                badge or Home Assistant logo - <strong
                  >before purchase is made</strong
                >.
              </p>
              <p>
                Wording about the limitation must be specific, and clearly
                explain what it means for the customer.
              </p>

              <p>Here are two approved examples:</p>
              <ul>
                <li>
                  “This device requires a Home Assistant-compatible Zigbee
                  coordinator to connect (sold separately).”
                </li>
                <li>
                  “This device supports on/off control via Home Assistant, but
                  dimming is not currently supported.”
                </li>
              </ul>
            </GuidelineCard>

            <NoteCard>
              <p>
                Should your device no longer be certified by the Works with Home
                Assistant program, <strong
                  >please remove all badges, logos and references to the program
                  immediately.</strong
                >
              </p>
            </NoteCard>
          </section>

          <hr class="part-divider" />

          <section id="need-help" class="guide-panel">
            <h2>Need help?</h2>
            <p>
              Thank you for your commitment to our mission. By using these
              guidelines you’re helping build trusted, consistent, and
              recognizable brands for our entire community, as well as people
              who are new to open smart homes.
            </p>
            <p>
              <strong
                >Have questions? Please contact us directly: <a
                  href="mailto:partner@openhomefoundation.org"
                  >partner@openhomefoundation.org</a
                ></strong
              >
            </p>
          </section>
        </div>
      </div>
    </article>
  </div>
</Base>
