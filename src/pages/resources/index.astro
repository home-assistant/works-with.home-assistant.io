---
import Base from "../../layouts/Base.astro";
import resourceSections from "../../data/resources.json";

const isDownload = (link: string) => link.endsWith(".pdf");
---

<Base
	title="Resources"
	description="Guides, downloads, and other resources for the Works with Home Assistant program."
>
	<div class="wrapper wrapper-a">
		<section class="resources-hero">
			<div class="container">
				<h1>Resources</h1>
				<p class="contained">
					Guides, downloads, and other resources for manufacturers certifying
					products through the Works with Home Assistant program.
				</p>
			</div>
		</section>

		<section class="resources">
			<div class="container">
				{
					resourceSections.map((section) => (
						<div class="resources-section">
							<h2>{section.title}</h2>
							{section.description && (
								<p class="section-intro">{section.description}</p>
							)}
							<div class="cards">
								{section.cards.map((card) => (
									<a
										href={card.link}
										class="card nounderline"
										target={isDownload(card.link) ? "_blank" : undefined}
										rel={isDownload(card.link) ? "noopener noreferrer" : undefined}
									>
										<div class="icon">
											{isDownload(card.link) ? (
												<svg
													xmlns="http://www.w3.org/2000/svg"
													height="24px"
													viewBox="0 -960 960 960"
													width="24px"
													fill="currentColor"
												>
													<path d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z" />
												</svg>
											) : (
												<svg
													xmlns="http://www.w3.org/2000/svg"
													height="24px"
													viewBox="0 -960 960 960"
													width="24px"
													fill="currentColor"
												>
													<path d="M320-240h320v-80H320v80Zm0-160h320v-80H320v80ZM240-80q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80H240Zm280-520v-200H240v640h480v-440H520ZM240-800v200-200 640-640Z" />
												</svg>
											)}
										</div>
										<div class="title">{card.title}</div>
										{card.description && (
											<div class="description">{card.description}</div>
										)}
										<div class="cta">
											<span>{isDownload(card.link) ? "Download PDF" : "Read guide"}</span>
											<span class="arrow">&rarr;</span>
										</div>
									</a>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>
	</div>
</Base>
