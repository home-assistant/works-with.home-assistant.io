---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<div class="wrapper wrapper-b">
		<div class="bg-lines"></div>
		<section class="error-page" id="error-404">
			<div class="container">
				<p class="error-code">404</p>
				<h1>This page took the day off</h1>
				<p class="error-message">
					The page you're looking for doesn't exist, moved, or never existed in
					the first place. Let's get you back on track.
				</p>
				<div class="error-actions">
					<a href="/" class="button animated large">Back to home</a>
					<a href="/certified-products/" class="button-secondary"
						>Browse certified products</a
					>
				</div>
			</div>
		</section>
	</div>

	<script is:inline>
		document.addEventListener("DOMContentLoaded", function () {
			if (typeof window.plausible === "function") window.plausible("404");
		});
	</script>
</Base>
